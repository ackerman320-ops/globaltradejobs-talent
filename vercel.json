{
  "routes": [
    {
      "src": "/api/job-boardly-webhook",
      "dest": "/api/job-boardly-webhook.js"
    },
    {
      "src": "/gtj_consultants_globe.html",
      "has": [{"type": "host", "value": "consultants.globaltradejobs.com"}],
      "dest": "/gtj_consultants_globe.html"
    },
    {
      "src": "/firm/(.*)",
      "has": [{"type": "host", "value": "consultants.globaltradejobs.com"}],
      "dest": "/firm/index.html"
    },
    {
      "src": "/(.*)",
      "has": [{"type": "host", "value": "consultants.globaltradejobs.com"}],
      "dest": "/consultants/index.html"
    },
    {
      "src": "/gtj_globe.html",
      "has": [{"type": "host", "value": "candidates.globaltradejobs.com"}],
      "dest": "/gtj_globe.html"
    },
    {
      "src": "/candidate/(.*)",
      "has": [{"type": "host", "value": "candidates.globaltradejobs.com"}],
      "dest": "/candidate/index.html"
    },
    {
      "src": "/(.*)",
      "has": [{"type": "host", "value": "candidates.globaltradejobs.com"}],
      "dest": "/index.html"
    },
    {
      "src": "/gtj_network_globe.html",
      "has": [{"type": "host", "value": "community.globaltradejobs.com"}],
      "dest": "/gtj_network_globe.html"
    },
    {
      "src": "/(.*)",
      "has": [{"type": "host", "value": "community.globaltradejobs.com"}],
      "dest": "/community/index.html"
    },
    {
      "src": "/(.*)",
      "has": [{"type": "host", "value": "courses.globaltradejobs.com"}],
      "dest": "/courses/index.html"
    }
  ]
}
